# Copy to .env. Vite exposes only VITE_-prefixed variables, and inlines them into
# the client bundle, so nothing secret belongs in this file.

# Required. Reown (WalletConnect) project id, from https://dashboard.reown.com.
# Public by design: it ships in the bundle, which is why it is committed here.
VITE_WALLET_CONNECT_PROJECT_ID=37bbe7c17829c142d9439aef7657adca

# Optional. Adds a "Local" entry to the environment picker and makes it the default.
# Staging and production are compiled in and need no configuration, so leave this
# commented out unless you are running Atlas yourself.
# VITE_ATLAS_GRAPHQL_URL=http://127.0.0.1:3001/graphql

# Optional, development builds only. A throwaway key that signs in without a wallet
# extension, for use against a local Atlas. Production builds ignore it, and it holds
# no admin role on staging or production, so it is useless against either.
